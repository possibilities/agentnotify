{
  "name": "agentnotify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Send and browse desktop notifications from agents and scripts",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "bin": {
    "agentnotify": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "vite",
    "build": "vite build",
    "lint": "biome check .",
    "format": "biome format --write src test scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "node-notifier-cli": "^1.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
